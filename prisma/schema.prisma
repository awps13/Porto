// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// DATABASE_URL is loaded via prisma.config.ts (Prisma 7+).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  DATABASE_URL = env("DATABASE_URL")
}

// ============================================================================
// AUTH
// ============================================================================

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  avatar       String?
  role         Role      @default(ADMIN)
  lastLoginAt  DateTime?
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// PROFILE — singleton record describing the portfolio owner
// ============================================================================

model Profile {
  id        String   @id @default(cuid())
  fullName  String
  headline  String? // e.g. "Frontend Developer"
  tagline   String? // hero subtitle
  bio       String?
  avatar    String?
  email     String?
  phone     String?
  location  String?
  resumeUrl String?
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// PROJECTS
// ============================================================================

model Project {
  id           String       @id @default(cuid())
  slug         String       @unique
  title        String
  category     String? // e.g. "Web / Civic", "UI/UX"
  summary      String? // short blurb for cards
  description  String? // long description
  role         String? // your role in the project
  cover        String? // cover image url
  gallery      String[] // additional image urls
  linkCode     String?
  linkWebsite  String?
  linkDemo     String?
  featured     Boolean      @default(false)
  published    Boolean      @default(true)
  order        Int          @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  technologies Technology[]
  tags         Tag[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([published, order])
  @@index([featured])
}

model Technology {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String    @unique
  icon      String? // icon path, e.g. /technologies/nextjs.svg
  category  String? // "frontend", "backend", "tools"
  order     Int       @default(0)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
}

// ============================================================================
// CERTIFICATES
// ============================================================================

model Certificate {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  subtitle       String?
  issuer         String? // e.g. "Cisco Networking Academy"
  description    String?
  image          String?
  certificateUrl String? // link to view certificate
  credentialId   String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  featured       Boolean   @default(false)
  published      Boolean   @default(true)
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, order])
}

// ============================================================================
// EXPERIENCE — work, education, volunteer, internship
// ============================================================================

enum ExperienceType {
  WORK
  EDUCATION
  INTERNSHIP
  VOLUNTEER
  FREELANCE
}

model Experience {
  id           String         @id @default(cuid())
  type         ExperienceType @default(WORK)
  role         String // job title / degree / position
  organization String // company / school / org
  location     String?
  description  String?
  highlights   String[] // bullet-point achievements
  logo         String?
  url          String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean        @default(false)
  published    Boolean        @default(true)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([type, order])
  @@index([current])
}

// ============================================================================
// SKILLS
// ============================================================================

model Skill {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  category  String? // "frontend", "backend", "design", "soft"
  level     Int? // 1-5 self-assessed
  icon      String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
}

// ============================================================================
// CONTACT — social/contact links shown in the UI
// ============================================================================

enum ContactType {
  EMAIL
  PHONE
  WHATSAPP
  LINKEDIN
  GITHUB
  INSTAGRAM
  TIKTOK
  TWITTER
  YOUTUBE
  WEBSITE
  OTHER
}

model Contact {
  id        String      @id @default(cuid())
  type      ContactType
  label     String // "LinkedIn", "Email", etc.
  value     String // url or address
  icon      String? // path to icon, e.g. /contacts/linkedin.svg
  order     Int         @default(0)
  primary   Boolean     @default(false)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([active, order])
}

// ============================================================================
// MESSAGES — submissions from the public contact form
// ============================================================================

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
  SPAM
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String
  status    MessageStatus @default(UNREAD)
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())
  readAt    DateTime?

  @@index([status, createdAt])
}
